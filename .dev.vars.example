# Server-side local development only. Copy to .dev.vars; never commit real secrets.
AUTH_ORIGIN=http://127.0.0.1:4181
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A base64url encoded, randomly generated 32-byte key; use separate local and production keys.
AUTH_COOKIE_KEY=
# Stripe sandbox only. Live keys are deliberately not accepted by these routes.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
BILLING_TEST_ENABLED=false
CLOUD_TEST_ENABLED=false
# Cloud sandbox also requires local D1, private R2 and Queue bindings; see README.
# Optional AI pilot. Keep disabled until the AI migration and pilot setup are complete.
AI_TEST_ENABLED=false
FAL_KEY=
# Comma-separated verified Google login emails; use a Cloudflare Secret remotely.
AI_TEST_ALLOWED_EMAILS=
AI_DAILY_BUDGET_CENTS=500
