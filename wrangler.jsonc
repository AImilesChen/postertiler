{
  "name": "postertiler",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "postertiler.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  }
}
